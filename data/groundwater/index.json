    "method": {
      "signConvention": "Source values are negative metres; NWDP describes them as groundwater depth below the surface. Shown here as positive depth.",
      "validRange": "0 < depth <= 200 m; other readings excluded and counted",
      "daily": "median of the day's six-hourly readings (timestamps as published, assumed IST)",
      "spikes": "daily value dropped if more than max(3 x scaled MAD, 1 m) from the median of the surrounding +/-3 days",
      "current": "median of the last 3 clean days; station 'current' if that is within 7 days of the dataset's last observation",
      "change30d": "current depth minus the median of clean days 30+/-3 days earlier; positive = water further down",
      "vsMay": "May median depth minus current depth (needs 10+ clean May days); positive = water higher than before the monsoon",
      "trend": "falling / rising when the 30-day change exceeds 0.5 m; otherwise steady",
      "erratic": "more than 20% of readings excluded or 20% of days flagged as spikes; left out of district medians",
      "flat": "clean readings varied less than 0.1 m over the last 90 days; the well may be dry below the sensor or the sensor stuck. Shown with a note and kept in medians"
    },
    "limitations": [
      "A station is one monitoring well. Its depth does not tell you the water level in another village's well or borewell.",
      "Depth to water is not a volume. It cannot say how many litres a village has left or how long they will last.",
      "District medians use only current, stable stations and can hide large local differences.",
      "This CSV starts on 1 January 2026, so there is no comparison with the same date last year.",
      "Mumbai City and Mumbai Suburban have no stations in this dataset."
    ]
